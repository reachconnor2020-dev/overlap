// Overlap — database schema
// A "Couple" is the unit that has an account and appears in discovery.
// Two individual People belong to one Couple. Matching is Couple <-> Couple.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TagCategory {
  INTEREST
  HOBBY
  VALUE
  POLITICS
}

enum SwipeDirection {
  PASS
  LIKE
}

model Couple {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String // e.g. "Sam & Jordan"
  city          String?
  latitude      Float?
  longitude     Float?
  bio           String?
  photoUrl      String?
  onboarded     Boolean   @default(false)
  emailVerified Boolean   @default(false)
  verificationCode        String?
  verificationCodeExpires DateTime?
  passwordResetCode        String?
  passwordResetCodeExpires DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  people        Person[]
  tags          CoupleTag[]

  swipesMade    Swipe[]   @relation("SwipesMade")
  swipesReceived Swipe[]  @relation("SwipesReceived")

  matchesA      Match[]   @relation("MatchCoupleA")
  matchesB      Match[]   @relation("MatchCoupleB")

  blocksMade      Block[]  @relation("BlocksMade")
  blocksReceived  Block[]  @relation("BlocksReceived")
  reportsMade     Report[] @relation("ReportsMade")
  reportsReceived Report[] @relation("ReportsReceived")
}

model Block {
  id              String   @id @default(cuid())
  blockerCoupleId String
  blockedCoupleId String
  createdAt       DateTime @default(now())

  blocker Couple @relation("BlocksMade", fields: [blockerCoupleId], references: [id], onDelete: Cascade)
  blocked Couple @relation("BlocksReceived", fields: [blockedCoupleId], references: [id], onDelete: Cascade)

  @@unique([blockerCoupleId, blockedCoupleId])
}

model Report {
  id               String   @id @default(cuid())
  reporterCoupleId String
  reportedCoupleId String
  reason           String
  details          String?
  createdAt        DateTime @default(now())

  reporter Couple @relation("ReportsMade", fields: [reporterCoupleId], references: [id], onDelete: Cascade)
  reported Couple @relation("ReportsReceived", fields: [reportedCoupleId], references: [id], onDelete: Cascade)
}

model Person {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  name      String
  age       Int?
  createdAt DateTime @default(now())
}

model Tag {
  id       String      @id @default(cuid())
  label    String      @unique
  category TagCategory

  couples  CoupleTag[]
}

// Join table with an optional weight, so "politics" alignment can be
// weighted differently than a shared hobby if a couple cares more about it.
model CoupleTag {
  coupleId String
  tagId    String
  weight   Int      @default(1) // 1 = normal, 2 = "this matters a lot to us"

  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([coupleId, tagId])
}

model Swipe {
  id             String         @id @default(cuid())
  fromCoupleId   String
  toCoupleId     String
  direction      SwipeDirection
  createdAt      DateTime       @default(now())

  fromCouple     Couple @relation("SwipesMade", fields: [fromCoupleId], references: [id], onDelete: Cascade)
  toCouple       Couple @relation("SwipesReceived", fields: [toCoupleId], references: [id], onDelete: Cascade)

  @@unique([fromCoupleId, toCoupleId])
}

model Match {
  id          String    @id @default(cuid())
  coupleAId   String
  coupleBId   String
  score       Int // compatibility score at time of match, 0-100
  createdAt   DateTime  @default(now())

  coupleA     Couple    @relation("MatchCoupleA", fields: [coupleAId], references: [id], onDelete: Cascade)
  coupleB     Couple    @relation("MatchCoupleB", fields: [coupleBId], references: [id], onDelete: Cascade)

  messages    Message[]

  @@unique([coupleAId, coupleBId])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderCoupleId String
  body      String
  createdAt DateTime @default(now())

  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}
